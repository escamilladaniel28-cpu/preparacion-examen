# ==============================================================================
# CoSpace — Variables de Entorno de Ejemplo
# ==============================================================================

# 1. DATABASE_URL: Cadena de conexión al Transaction Pooler de Supabase (puerto 6543)
# Obtener en Supabase Dashboard: Project Settings > Database > Connection String (URI / Transaction Pooler)
# IMPORTANTE en producción (Vercel): Añadir ?pgbouncer=true&connection_limit=1 al final
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 2. DIRECT_URL: Cadena de conexión directa para migraciones y Prisma CLI (puerto 5432 o Session Pooler)
# Obtener en Supabase Dashboard: Project Settings > Database > Connection String (Direct Connection o Session Pooler)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

# 3. JWT_ACCESS_SECRET: Secreto criptográfico para firmar los Access Tokens (mínimo 32 caracteres)
JWT_ACCESS_SECRET="clave_secreta_jwt_access_super_segura_de_al_menos_32_caracteres"

# 4. JWT_REFRESH_SECRET: Secreto criptográfico para firmar los Refresh Tokens (mínimo 32 caracteres)
JWT_REFRESH_SECRET="clave_secreta_jwt_refresh_super_segura_de_al_menos_32_caracteres"

# 5. NEXT_PUBLIC_ADMIN_PIN: Código PIN numérico de verificación para el acceso rápido de administrador en login
NEXT_PUBLIC_ADMIN_PIN="2828"
